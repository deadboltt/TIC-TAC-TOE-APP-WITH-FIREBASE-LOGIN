<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material Components in Night Mode -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_indigo</item>
        <item name="colorPrimaryVariant">@color/primary_indigo_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/player_o</item>
        <item name="colorSecondaryVariant">@color/player_o</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <!-- Outlined text input style -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
    </style>
</resources>