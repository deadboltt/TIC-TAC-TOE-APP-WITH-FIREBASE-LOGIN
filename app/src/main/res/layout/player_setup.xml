<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp"
    tools:context=".PlayerSetup">

    <!-- Header -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playersetuptitle"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/setupSub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/setupSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:text="Choose your battle names"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/player1Card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <!-- Player 1 Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player1Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_glass_bg"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@+id/player2Card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setupSub">

        <TextView
            android:id="@+id/p1Badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/card_glass_bg"
            android:gravity="center"
            android:text="X"
            android:textColor="@color/player_x"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Player 1"
            android:textColor="@color/player_x"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/p1Badge"
            app:layout_constraintStart_toEndOf="@+id/p1Badge"
            app:layout_constraintTop_toTopOf="@+id/p1Badge" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/p1InputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Enter Name"
            android:textColorHint="@color/text_secondary"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/player_x"
            app:boxStrokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@+id/p1Badge"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@color/player_x">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/player1name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:text="Player 1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Player 2 Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player2Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/card_glass_bg"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@+id/button2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player1Card">

        <TextView
            android:id="@+id/p2Badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/card_glass_bg"
            android:gravity="center"
            android:text="O"
            android:textColor="@color/player_o"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Player 2"
            android:textColor="@color/player_o"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/p2Badge"
            app:layout_constraintStart_toEndOf="@+id/p2Badge"
            app:layout_constraintTop_toTopOf="@+id/p2Badge" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/p2InputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Enter Name"
            android:textColorHint="@color/text_secondary"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/player_o"
            app:boxStrokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@+id/p2Badge"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@color/player_o">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/player2name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:text="Player 2"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Start Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/btn_gradient_primary"
        android:elevation="6dp"
        android:onClick="submitbuttonclick"
        android:text="Start Match"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player2Card" />

</androidx.constraintlayout.widget.ConstraintLayout>