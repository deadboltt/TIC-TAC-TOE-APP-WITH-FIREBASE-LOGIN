<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Top bar with sign out button -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/logoutBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/btn_glass_secondary"
        android:onClick="logoutbuttonclick"
        android:src="@drawable/ic_logout"
        android:tint="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Hero Section -->
    <LinearLayout
        android:id="@+id/heroSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/actionSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoutBtn"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Visual X and O Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/card_glass_bg"
                android:gravity="center"
                android:text="X"
                android:textColor="@color/player_x"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/card_glass_bg"
                android:gravity="center"
                android:text="O"
                android:textColor="@color/player_o"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hometitle"
            android:textColor="@color/text_primary"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pass &amp; Play Multiplayer"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/actionSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heroSection">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_gradient_primary"
            android:elevation="6dp"
            android:onClick="playbuttonclick"
            android:text="▶  Play Game"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>